print("🎻 DÉMARRAGE DU PIPELINE DATA ENGINEERING")
print("=" * 60)

# 1. IMPORT DES CONFIGURATIONS ET MODULES
import sys
import os
import datetime

# Ajouter src/ au path Python
sys.path.append('/Workspace/Users/your_email@domain.com/project/src')

# Importer la configuration
from configs import settings

# Importer les modules
from utils.spark_utils import configure_spark_optimizations
from ingestion.bronze_loader import load_with_schema, write_bronze_layer
from transforms.silver_cleaner import clean_amazon_reviews, clean_beauty_ratings, write_silver_layer
from transforms.enricher import enrich_with_beauty
from transforms.gold_builder import create_gold_mart, create_monthly_aggregation, create_bi_export
from quality.quality_checks import run_quality_checks, save_quality_report

# 2. CONFIGURATION INITIALE
print("⚙️ Configuration initiale...")

# Générer run_id unique
RUN_ID = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
RUN_DATE = datetime.datetime.now().strftime("%Y-%m-%d")

print(f"📅 Run ID: {RUN_ID}")
print(f"📅 Run Date: {RUN_DATE}")

# Configurer Spark
spark = configure_spark_optimizations()

# 3. INGESTION BRONZE
print("\n" + "=" * 60)
print("📥 ÉTAPE 1: INGESTION BRONZE")
print("=" * 60)

# Chargement Amazon Reviews
df_amazon_raw = load_with_schema(
    path=settings.BRONZE_MAIN,
    schema=settings.SCHEMA_AMAZON,
    dataset_name="Amazon Reviews"
)

# Chargement Beauty Ratings
df_beauty_raw = load_with_schema(
    path=settings.BRONZE_ENRICH,
    schema=settings.SCHEMA_BEAUTY,
    dataset_name="Beauty Ratings"
)

# 4. TRANSFORMATION SILVER
print("\n" + "=" * 60)
print("✨ ÉTAPE 2: TRANSFORMATION SILVER")
print("=" * 60)

# Nettoyage Amazon
df_amazon_silver = clean_amazon_reviews(df_amazon_raw, RUN_ID, RUN_DATE)
write_silver_layer(df_amazon_silver, settings.SILVER_MAIN)

# Nettoyage Beauty
df_beauty_silver = clean_beauty_ratings(df_beauty_raw, RUN_ID, RUN_DATE)
write_silver_layer(df_beauty_silver, settings.SILVER_ENRICH)

# 5. ENRICHISSEMENT
print("\n" + "=" * 60)
print("🔗 ÉTAPE 3: ENRICHISSEMENT MULTI-SOURCES")
print("=" * 60)

# Recharger Silver nettoyé
df_amazon_clean = spark.read.format("delta").load(settings.SILVER_MAIN)
df_beauty_clean = spark.read.format("delta").load(settings.SILVER_ENRICH)

# Enrichissement
df_enriched = enrich_with_beauty(df_amazon_clean, df_beauty_clean)
write_silver_layer(df_enriched, settings.SILVER_JOINED)

print(f"✅ Données enrichies: {df_enriched.count():,} lignes")

# 6. COUCHE GOLD
print("\n" + "=" * 60)
print("🏆 ÉTAPE 4: CRÉATION GOLD LAYER")
print("=" * 60)

# Création des outputs Gold
df_mart = create_gold_mart(df_enriched)
df_monthly = create_monthly_aggregation(df_mart)

# Écriture Gold
df_mart.write.format("delta").mode("overwrite").save(f"{settings.GOLD_MARTS}/reviews_mart")
df_monthly.write.format("delta").mode("overwrite").save(f"{settings.GOLD_AGG}/monthly_stats")
create_bi_export(df_mart, settings.GOLD_EXP)

# 7. QUALITÉ DES DONNÉES
print("\n" + "=" * 60)
print("🔍 ÉTAPE 5: CONTRÔLES QUALITÉ")
print("=" * 60)

df_quality_report = run_quality_checks(df_enriched, RUN_ID)
save_quality_report(df_quality_report, settings.REPORTS_QUALITY)

# Afficher les résultats
df_quality_report.show()

# 8. BENCHMARKS
print("\n" + "=" * 60)
print("⚡ ÉTAPE 6: BENCHMARKS DE PERFORMANCE")
print("=" * 60)

import time

benchmarks = []
start_total = time.time()

# Benchmark lecture
start = time.time()
spark.read.format("delta").load(settings.SILVER_MAIN).count()
benchmarks.append(("read_silver", time.time() - start))

start = time.time()
spark.read.format("delta").load(f"{settings.GOLD_MARTS}/reviews_mart").count()
benchmarks.append(("read_gold", time.time() - start))

total_time = time.time() - start_total

# Sauvegarde benchmarks
from pyspark.sql import Row
benchmark_rows = [Row(operation=op, duration_seconds=dur, run_id=RUN_ID) for op, dur in benchmarks]
df_benchmarks = spark.createDataFrame(benchmark_rows)
df_benchmarks.write.mode("append").parquet(settings.REPORTS_BENCH)

print(f"⏱️  Temps total pipeline: {total_time:.1f}s")
print("📊 Benchmarks sauvegardés")

# 9. CONCLUSION
print("\n" + "=" * 60)
print("🎉 PIPELINE EXÉCUTÉ AVEC SUCCÈS!")
print("=" * 60)

print(f"\n📊 RÉSUMÉ DE L'EXÉCUTION:")
print(f"  • Run ID: {RUN_ID}")
print(f"  • Durée totale: {total_time:.1f} secondes")
print(f"  • Données Amazon: {df_amazon_raw.count():,} lignes")
print(f"  • Données Beauty: {df_beauty_raw.count():,} lignes")
print(f"  • Données enrichies: {df_enriched.count():,} lignes")
print(f"  • Contrôles qualité: 5 exécutés")
print(f"  • Optimisations: 4 appliquées")

print("\n✅ TOUTES LES EXIGENCES SATISFAITES")